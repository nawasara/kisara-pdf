{
    "name": "nawasara/kisara-pdf",
    "description": "Kisara PDF activity history for the Nawasara superapp framework: batch ingest API for the Kisara PDF gateway, per-employee history API, audit page and daily usage statistics.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "pdf",
        "kisara",
        "audit"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/kisara-pdf/issues",
        "source": "https://github.com/nawasara/kisara-pdf"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\KisaraPdf\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.0",
        "livewire/livewire": "^3.0",
        "nawasara/ui": "*",
        "nawasara/sync": "*"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\KisaraPdf\KisaraPdfServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
